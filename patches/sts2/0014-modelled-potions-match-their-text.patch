+    /// <summary>"Draw 1 card. At the start of your next 3 turns, draw 1 additional card."</summary>
+    [Fact]
+    public void ClarityExtractDrawsOneNow()
+    {
+        var fight = WithPotion(Id("Clarity")).Draw(new CardInstance(472, false), new CardInstance(472, false), new CardInstance(472, false));
+        int hand = fight.State.Hand.Count;
+
+        fight.Potion(0);
+
+        Assert.Equal(hand + 1, fight.State.Hand.Count);
+        Assert.Equal(3, fight.PlayerBuffAmount(BuffId.Clarity));
+    }
+
+    /// <summary>"Gain [E]. Gain an additional [E] at the start of your next 3 turns."</summary>
+    [Fact]
+    public void RadiantTinctureGivesOneEnergyNow()
+    {
+        var fight = WithPotion(Id("RadiantTincture"));
+        int energy = fight.State.Energy;
+
+        fight.Potion(0);
+
+        Assert.Equal(energy + 1, fight.State.Energy);
+        Assert.Equal(3, fight.PlayerBuffAmount(BuffId.Radiance));
+    }
+
+    /// <summary>"Gain 12 Block": unpowered, so Frail and Dexterity leave it alone.</summary>
+    [Fact]
+    public void BlockPotionIsAFlatTwelve()
+    {
+        var fight = WithPotion(Id("BlockPotion"));
+        BuffSystem.Apply(fight.State.PlayerBuffs, BuffId.Frail, 2);
+        BuffSystem.Apply(fight.State.PlayerBuffs, BuffId.Dexterity, 2);
+
+        fight.Potion(0);
+
+        Assert.Equal(12, fight.State.PlayerBlock);
+    }
+
