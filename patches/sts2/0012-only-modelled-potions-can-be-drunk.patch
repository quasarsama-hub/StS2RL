+using System.Linq;
+using Sts2Emulator.Core;
+using Sts2Emulator.Core.Effects;
+using Xunit;
+
+namespace Sts2Emulator.Tests;
+
+/// <summary>
+/// Only potions with a modelled effect can be drunk. Drinking any other did nothing but
+/// empty its slot, which the game never does, and an agent searching over it learned a
+/// discard where the game would have applied the potion.
+/// </summary>
+public class PotionModelledTests
+{
+    private static int Id(string name) => GeneratedData.Potions.FindId(name)!.Value;
+
+    private static Fight WithPotion(int potionId)
+    {
+        var fight = Fight.Hand().Energy(3);
+        fight.State.PotionSlots[0] = potionId;
+        return fight;
+    }
+
+    private static bool Offered(Fight fight) =>
+        CombatEngine.ValidActions(fight.State).Contains(fight.State.Hand.Count + 1);
+
+    [Fact]
+    public void OnlyModelledPotionsAreOffered()
+    {
+        for (int id = 1; id <= 63; id++)
+        {
+            Assert.Equal(PotionEffects.IsModelled(id), Offered(WithPotion(id)));
+        }
+
+        Assert.True(Offered(WithPotion(Id("BlockPotion"))));
+        Assert.False(Offered(WithPotion(Id("FirePotion"))));
+    }
+
+    /// <summary>Fairy in a Bottle is Automatic: never drunk by hand, kept for its revive.</summary>
+    [Fact]
+    public void FairyInABottleIsNeverDrunkByHand()
+    {
+        var fight = WithPotion(Id("FairyInABottle"));
+
+        Assert.False(Offered(fight));
+        fight.Potion(0);
+        Assert.Equal(Id("FairyInABottle"), fight.State.PotionSlots[0]);
+    }
+
+    /// <summary>An unmodelled potion forced through stays in its slot.</summary>
+    [Fact]
+    public void AnUnmodelledPotionIsNotUsedUp()
+    {
+        var fight = WithPotion(Id("FirePotion"));
+
+        fight.Potion(0);
+
+        Assert.Equal(Id("FirePotion"), fight.State.PotionSlots[0]);
+    }
+}
