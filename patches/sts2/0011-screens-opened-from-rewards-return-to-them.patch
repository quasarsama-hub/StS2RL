+using System.Linq;
+using Sts2Emulator.Core;
+using Sts2Emulator.Core.Run;
+using Xunit;
+
+namespace Sts2Emulator.Tests;
+
+/// <summary>
+/// Screens a rewards screen opens come back to it, and what the screen held does not leak
+/// into later ones.
+/// </summary>
+public class RewardScreenReturnTests
+{
+    private static RunEngine Run(string seed = "NXV45HW43K")
+    {
+        var engine = new RunEngine();
+        engine.Reset(seed);
+        return engine;
+    }
+
+    private static void Step(RunEngine engine, int action) =>
+        Assert.Equal(0, engine.Step(action, -1, out _, out _, out _));
+
+    private static int[] Mask(RunEngine engine)
+    {
+        var mask = new int[RunConstants.MaxActions];
+        engine.WriteActionMask(mask);
+        return mask;
+    }
+
+    /// <summary>Picks deck cards until the selection screen closes.</summary>
+    private static void FinishSelection(RunEngine engine)
+    {
+        while (engine.State.Phase == RunPhase.TransformSelect)
+        {
+            int pick = Enumerable
+                .Range(0, engine.State.Deck.Count)
+                .First(i =>
+                    engine.State.PendingRestUpgrade
+                        ? RunConstants.IsRunCardUpgradable(engine.State.Deck[i])
+                        : RunNonCombatEffects.CanSelectCard(engine.State, i)
+                );
+            Step(engine, pick);
+        }
+    }
+
+    /// <summary>
+    /// A relic claimed off a fight's screen that opens a selection (Precise Scissors'
+    /// removal) opens it over the screen; the card reward is still there afterwards. It
+    /// used to go to the map and take the card reward with it.
+    /// </summary>
+    [Fact]
+    public void ASelectionARelicOpensComesBackToTheRewardsScreen()
+    {
+        var engine = Run();
+        RunRewardGenerator.PopulateCardReward(engine.State);
+        engine.State.RewardCardPending = true;
+        engine.State.RelicReward = RunNonCombatEffects.NamedRelic("PreciseScissors");
+        engine.State.Phase = RunPhase.RelicReward;
+
+        Step(engine, 0);
+        Assert.Equal(RunPhase.TransformSelect, engine.State.Phase);
+        FinishSelection(engine);
+
+        Assert.Equal(RunPhase.RelicReward, engine.State.Phase);
+        Assert.True(engine.State.RewardCardPending);
+        Assert.Equal(1, Mask(engine)[0]);
+    }
+
+    /// <summary>
+    /// Neow's Bones whose first relic opens a selection (here Precarious Shears): the
+    /// second relic is still offered, and claiming it adds the curse. The second relic and
+    /// the curse used to be lost, and the curse's flag left set.
+    /// </summary>
+    [Fact]
+    public void NeowsBonesSecondRelicSurvivesAScreenTheFirstOpens()
+    {
+        var engine = Run();
+        engine.State.Phase = RunPhase.Ancient;
+        engine.State.NeowOptions[0] = RunConstants.RelicNeowsBones;
+        Step(engine, 0);
+        engine.State.RelicReward = RunNonCombatEffects.NamedRelic("PrecariousShears");
+        int second = engine.State.PendingBonusRelicRewards.Single();
+
+        Step(engine, 0);
+        FinishSelection(engine);
+
+        Assert.Equal(RunPhase.RelicReward, engine.State.Phase);
+        Assert.Equal(second, engine.State.RelicReward);
+        Assert.Equal(0, Mask(engine)[RunConstants.RewardSkipAction]);
+        Step(engine, 0);
+        // The flag clears only as the curse is added (AddNeowsBonesCurse).
+        Assert.False(engine.State.PendingNeowsBonesCurse);
+        Assert.Equal(RunPhase.Ancient, engine.State.Phase);
+    }
+
+    /// <summary>The no-skip rule is Neow's own: a flag left over cannot hold a fight's screen.</summary>
+    [Fact]
+    public void ALeftoverNeowsBonesFlagDoesNotHoldALaterScreen()
+    {
+        var engine = Run();
+        engine.State.PendingNeowsBonesCurse = true;
+        engine.State.RewardGold = 15;
+        engine.State.Phase = RunPhase.RelicReward;
+
+        Assert.Equal(1, Mask(engine)[RunConstants.RewardSkipAction]);
+    }
+
+    /// <summary>
+    /// An elite's relic flag dies with its screen: Dream Catcher's card reward at the next
+    /// rest used to open a rewards screen with a freshly pulled relic.
+    /// </summary>
+    [Fact]
+    public void NoFreeRelicAfterAnEliteFromTheNextCardRewardWithoutAScreen()
+    {
+        var engine = Run();
+        RunNonCombatEffects.ApplyRelicPickup(engine.State, RunNonCombatEffects.NamedRelic("DreamCatcher"));
+        engine.State.PendingRelicReward = true;
+        engine.State.Phase = RunPhase.RelicReward;
+        Step(engine, RunConstants.RewardSkipAction);
+        int relics = engine.State.Relics.Count;
+
+        engine.State.Phase = RunPhase.Rest;
+        engine.State.RestOptionsTaken = 0;
+        engine.State.RestResultPending = false;
+        Step(engine, RunConstants.RestHealAction);
+        Assert.Equal(RunPhase.CardReward, engine.State.Phase);
+        Step(engine, RunConstants.RewardSkipAction);
+
+        Assert.NotEqual(RunPhase.RelicReward, engine.State.Phase);
+        Assert.Equal(relics, engine.State.Relics.Count);
+    }
+
+    /// <summary>Dream Catcher's card and Tiny Mailbox's potions share one rewards screen.</summary>
+    [Fact]
+    public void DreamCatchersCardSharesTinyMailboxsScreen()
+    {
+        var engine = Run();
+        RunNonCombatEffects.ApplyRelicPickup(engine.State, RunNonCombatEffects.NamedRelic("DreamCatcher"));
+        RunNonCombatEffects.ApplyRelicPickup(engine.State, RunNonCombatEffects.NamedRelic("TinyMailbox"));
+        engine.State.Phase = RunPhase.Rest;
+        engine.State.RestOptionsTaken = 0;
+        int deck = engine.State.Deck.Count;
+
+        Step(engine, RunConstants.RestHealAction);
+        Assert.Equal(RunPhase.RelicReward, engine.State.Phase);
+        Assert.True(engine.State.RewardCardPending);
+        Step(engine, 1); // the card item, after the potion
+        Assert.Equal(RunPhase.CardReward, engine.State.Phase);
+        Step(engine, 0);
+
+        Assert.Equal(deck + 1, engine.State.Deck.Count);
+    }
+
+    /// <summary>
+    /// Smithing is spent like any other rest option: with Miniature Tent the site stays
+    /// open and Heal still heals. It used to end the visit, Heal leaving without healing.
+    /// </summary>
+    [Fact]
+    public void WithMiniatureTentSmithingFirstStillLeavesHeal()
+    {
+        var engine = Run();
+        RunNonCombatEffects.ApplyRelicPickup(engine.State, RunNonCombatEffects.NamedRelic("MiniatureTent"));
+        engine.State.Phase = RunPhase.Rest;
+        engine.State.RestOptionsTaken = 0;
+        engine.State.PlayerHp = 20;
+
+        Step(engine, RunConstants.RestUpgradeAction);
+        FinishSelection(engine);
+        Assert.Equal(RunPhase.Rest, engine.State.Phase);
+        var mask = Mask(engine);
+        Assert.Equal(0, mask[RunConstants.RestUpgradeAction]);
+        Assert.Equal(1, mask[RunConstants.RestHealAction]);
+        Step(engine, RunConstants.RestHealAction);
+
+        Assert.True(engine.State.PlayerHp > 20);
+    }
+}
