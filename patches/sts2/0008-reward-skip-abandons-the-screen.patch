@@ -1954,6 +1954,15 @@ public sealed class RunEngine
             // wrong for every event, whose second queued potion is declined far more often
             // than it is taken.
             State.PendingPotionRewards.Clear();
+            // And everything else on it: the card reward and the offers queued behind it,
+            // Kaleidoscope's, Prayer Wheel's still owed, the bonus relics. Only the potions
+            // went, so the rest stayed in the state and came back on a later screen that
+            // never had them -- an event's potion offer resets gold, relic and potion only,
+            // and an unclaimed Prayer Wheel reward added up fight after fight.
+            RunRewardGenerator.ClearRewardScreen(State);
+            State.PendingOtherCharacterCardRewards = 0;
+            State.PendingBonusRelicRewards.Clear();
+            State.ExtraCardRewardsOwed = 0;
             return LeaveRewardScreen(out terminal);
         }
 
