@@ -493,7 +493,33 @@ public static class RunRewardGenerator
                 // which runs its AfterObtained -- a live capture's Silken Tress zeroed the
                 // player's gold the moment it was taken. Adding it to the list and
                 // stopping there is what this used to do.
-                RunNonCombatEffects.ApplyRelicPickup(state, claimed);
+                var screen = state.Phase;
+                var followUp = RunNonCombatEffects.ApplyRelicPickup(state, claimed);
+                // What its AfterObtained offers lands here however the relic was obtained:
+                // Lost Coffer's and Kaleidoscope's rewards join this screen, and Scroll
+                // Boxes' bundle opens over it.
+                OfferRelicPickupRewards(state, claimed);
+                if (followUp == RunFollowUp.BundleSelect)
