+using System.Linq;
+using Sts2Emulator.Core;
+using Sts2Emulator.Core.Run;
+using Xunit;
+
+namespace Sts2Emulator.Tests;
+
+/// <summary>
+/// A relic claimed off a rewards screen does what its AfterObtained does however it was
+/// obtained, the screens it opens come back to the rewards screen -- and only those.
+/// </summary>
+public class RelicClaimFollowUpTests
+{
+    private static RunEngine Run(string seed = "NXV45HW43K")
+    {
+        var engine = new RunEngine();
+        engine.Reset(seed);
+        return engine;
+    }
+
+    private static void Step(RunEngine engine, int action) =>
+        Assert.Equal(0, engine.Step(action, -1, out _, out _, out _));
+
+    private static int Relic(string name) => RunNonCombatEffects.NamedRelic(name);
+
+    private static void FinishSelection(RunEngine engine)
+    {
+        while (engine.State.Phase == RunPhase.TransformSelect)
+        {
+            Step(
+                engine,
+                Enumerable
+                    .Range(0, engine.State.Deck.Count)
+                    .First(i => RunNonCombatEffects.CanSelectCard(engine.State, i))
+            );
+        }
+    }
+
+    /// <summary>Neow's Bones' screen holding <paramref name="first" />, then <paramref name="second" />.</summary>
+    private static RunEngine Bones(int first, int second)
+    {
+        var engine = Run();
+        engine.State.Phase = RunPhase.Ancient;
+        engine.State.NeowOptions[0] = RunConstants.RelicNeowsBones;
+        Step(engine, 0);
+        engine.State.RelicReward = first;
+        engine.State.PendingBonusRelicRewards[0] = second;
+        return engine;
+    }
+
+    /// <summary>Small Capsule's relic goes ahead of the Bones' second, not instead of it.</summary>
+    [Fact]
+    public void SmallCapsuleOffNeowsBonesKeepsTheSecondRelic()
+    {
+        int second = Relic("Vajra");
+        var engine = Bones(Relic("SmallCapsule"), second);
+
+        Step(engine, 0);
+        Assert.NotEqual(0, engine.State.RelicReward);
+        Assert.NotEqual(second, engine.State.RelicReward);
+        Step(engine, 0);
+
+        Assert.Equal(second, engine.State.RelicReward);
+        Step(engine, 0);
+        Assert.False(engine.State.PendingNeowsBonesCurse);
+        Assert.Equal(RunPhase.Ancient, engine.State.Phase);
+    }
+
+    /// <summary>Scroll Boxes off the Bones' screen opens its bundle, then comes back.</summary>
+    [Fact]
+    public void ScrollBoxesOffNeowsBonesOpensItsBundle()
+    {
+        int second = Relic("Vajra");
+        var engine = Bones(Relic("ScrollBoxes"), second);
+        int deck = engine.State.Deck.Count;
+
+        Step(engine, 0);
+        Assert.Equal(RunPhase.BundleSelect, engine.State.Phase);
+        Step(engine, 0);
+        Step(engine, RunConstants.BundleConfirmAction);
+
+        Assert.Equal(RunPhase.RelicReward, engine.State.Phase);
+        Assert.Equal(second, engine.State.RelicReward);
+        Assert.True(engine.State.Deck.Count > deck);
+    }
+
+    /// <summary>Lost Coffer's card reward and potion, and Kaleidoscope's two rewards, join the screen.</summary>
+    [Fact]
+    public void LostCofferAndKaleidoscopeOffNeowsBonesOfferTheirRewards()
+    {
+        var coffer = Bones(Relic("LostCoffer"), Relic("Kaleidoscope"));
+
+        Step(coffer, 0);
+        Assert.True(coffer.State.RewardCardPending);
+        Assert.NotEqual(0, coffer.State.RewardPotion);
+
+        var kaleidoscope = Bones(Relic("Kaleidoscope"), Relic("Vajra"));
+        Step(kaleidoscope, 0);
+        Assert.Equal(2, kaleidoscope.State.PendingOtherCharacterCardRewards);
+    }
+
+    /// <summary>
+    /// Neow's Bones' curse lands once its screen is done, after a removal its last relic
+    /// opened -- it used to land first, and Precise Scissors could take it straight out.
+    /// </summary>
+    [Fact]
+    public void NeowsBonesCurseComesAfterTheLastRelicsRemoval()
+    {
+        var engine = Bones(Relic("Vajra"), Relic("PreciseScissors"));
+        Step(engine, 0);
+        Step(engine, 0);
+        Assert.Equal(RunPhase.TransformSelect, engine.State.Phase);
+        Assert.True(engine.State.PendingNeowsBonesCurse);
+
+        FinishSelection(engine);
+
+        Assert.False(engine.State.PendingNeowsBonesCurse);
+        Assert.Equal(RunPhase.Ancient, engine.State.Phase);
+    }
+
+    /// <summary>
+    /// Reward state that outlived its screen does not send a later selection to a rewards
+    /// screen: a shop removal goes back to the shop.
+    /// </summary>
+    [Fact]
+    public void AShopRemovalReturnsToTheShopWhateverRewardStateIsLeft()
+    {
+        var engine = Run();
+        engine.State.Gold = 999;
+        RunRewardGenerator.EnterShop(engine.State);
+        engine.State.RewardCardPending = true; // left over from somewhere
+
+        Step(engine, RunConstants.ShopRemoveAction);
+        FinishSelection(engine);
+
+        Assert.Equal(RunPhase.Shop, engine.State.Phase);
+    }
+
+    /// <summary>The Future of Potions' card reward is opened directly and leaves nothing pending.</summary>
+    [Fact]
+    public void TheFutureOfPotionsLeavesNoCardRewardPending()
+    {
+        var engine = Run();
+        RunRewardGenerator.EnterFutureOfPotionsReward(
+            engine.State,
+            GeneratedData.Potions.FindId("FirePotion")!.Value,
+            engine.State.PlayerRng.Rewards
+        );
+
+        Assert.Equal(RunPhase.CardReward, engine.State.Phase);
+        Assert.False(engine.State.RewardCardPending);
+    }
+
+    /// <summary>
+    /// A removal the Forbidden Grimoire owes, opened as an Act 1 boss's rewards screen is
+    /// left, goes on into Act 2. It used to end the run.
+    /// </summary>
+    [Fact]
+    public void AGrimoireRemovalAtTheAct1BossGoesOnToAct2()
+    {
+        var engine = Run();
+        engine.State.CurrentNodeType = RunConstants.NodeBoss;
+        engine.State.CardRemovalsOwed = 1;
+        engine.State.Phase = RunPhase.RelicReward;
+        int act = engine.State.Act;
+
+        Step(engine, RunConstants.RewardSkipAction);
+        Assert.Equal(RunPhase.TransformSelect, engine.State.Phase);
+        FinishSelection(engine);
+
+        Assert.NotEqual(RunPhase.Complete, engine.State.Phase);
+        Assert.NotEqual(act, engine.State.Act);
+    }
+}
