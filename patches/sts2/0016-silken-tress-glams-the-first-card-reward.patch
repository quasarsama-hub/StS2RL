diff --git a/src/Sts2Emulator.Tests/Relics/SilkenTressTests.cs b/src/Sts2Emulator.Tests/Relics/SilkenTressTests.cs
new file mode 100644
index 0000000..9c10392
--- /dev/null
+++ b/src/Sts2Emulator.Tests/Relics/SilkenTressTests.cs
@@ -0,0 +1,72 @@
+using System.Linq;
+using Sts2Emulator.Core;
+using Sts2Emulator.Core.Run;
+using Xunit;
+
+namespace Sts2Emulator.Tests;
+
+/// <summary>
+/// Silken Tress: "Upon pickup, lose all Gold. Enchant all cards in the first card reward
+/// with Glam." Only the gold half was there, so a live run's Glam card played twice where
+/// the simulator played it once.
+/// </summary>
+public class SilkenTressTests
+{
+    private static void Step(RunEngine engine, int action) =>
+        Assert.Equal(0, engine.Step(action, -1, out _, out _, out _));
+
+    private static RunEngine TakeSilkenTress()
+    {
+        var engine = new RunEngine();
+        engine.Reset("GG0GRYBVJB");
+        engine.State.Phase = RunPhase.Ancient;
+        engine.State.NeowOptions[0] = RunConstants.RelicSilkenTress;
+        Step(engine, 0);
+        Assert.Equal(0, engine.State.Gold);
+        return engine;
+    }
+
+    private static CardInstance Pick(RunEngine engine, int option)
+    {
+        RunRewardGenerator.EnterCardReward(engine.State);
+        int deck = engine.State.Deck.Count;
+        Step(engine, option);
+        Assert.Equal(deck + 1, engine.State.Deck.Count);
+        return engine.State.Deck[^1];
+    }
+
+    [Fact]
+    public void TheFirstCardRewardIsGlamAndTheNextIsNot()
+    {
+        var engine = TakeSilkenTress();
+
+        var first = Pick(engine, 0);
+        Assert.Equal(Enchantment.Glam, first.Enchantment);
+        Assert.Equal(1, first.EnchantAmount);
+
+        var second = Pick(engine, 0);
+        Assert.Equal(Enchantment.None, second.Enchantment);
+    }
+
+    /// <summary>Every option on that screen is Glam, not one of them.</summary>
+    [Fact]
+    public void EveryOptionOnTheFirstScreenIsGlam()
+    {
+        for (int option = 0; option < 3; option++)
+        {
+            var engine = TakeSilkenTress();
+            Assert.Equal(Enchantment.Glam, Pick(engine, option).Enchantment);
+        }
+    }
+
+    /// <summary>Skipping the first card reward spends the charge all the same.</summary>
+    [Fact]
+    public void ASkippedFirstRewardStillSpendsIt()
+    {
+        var engine = TakeSilkenTress();
+        RunRewardGenerator.EnterCardReward(engine.State);
+        Step(engine, RunConstants.RewardSkipAction);
+
+        Assert.Equal(Enchantment.None, Pick(engine, 0).Enchantment);
+    }
+}
