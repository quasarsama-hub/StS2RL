+    /// <summary>
+    /// The observation carries the extra option in its own block at the end of the run
+    /// block, and nowhere else -- it used to be written into the deck block.
+    /// </summary>
+    [Fact]
+    public void TheFourthOptionIsObservedInItsOwnBlock()
+    {
+        var engine = CandyAtTriggeringCombat(2);
+        var obs = new int[RunConstants.RunObsSize];
+        engine.WriteObservation(obs);
+
+        int at = RunConstants.CombatObsSize + RunConstants.FourthRewardObsOffset;
+        Assert.Equal(engine.State.LastingCandyRewardCard, obs[at]);
+        int deckEnd = RunConstants.CombatObsSize + RunConstants.DeckObsOffset
+            + engine.State.Deck.Count * RunConstants.DeckSlotSize;
+        int relics = RunConstants.CombatObsSize + RunConstants.RelicObsOffset;
+        for (int i = deckEnd; i < relics; i++)
+        {
+            Assert.Equal(0, obs[i]);
+        }
+    }
+
