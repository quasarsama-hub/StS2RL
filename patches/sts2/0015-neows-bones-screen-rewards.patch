@@ -0,0 +1,107 @@
+using System.Linq;
+using Sts2Emulator.Core;
+using Sts2Emulator.Core.Run;
+using Xunit;
+
+namespace Sts2Emulator.Tests;
+
+/// <summary>
+/// Neow's Bones' screen holding relics whose pickups put rewards of their own on it (Lost
+/// Coffer, Kaleidoscope) or open a screen over it (Precise Scissors, Arcane Scroll's draw).
+/// </summary>
+public class NeowsBonesRewardTests
+{
+    private static void Step(RunEngine engine, int action) =>
+        Assert.Equal(0, engine.Step(action, -1, out _, out _, out _));
+
+    private static int Relic(string name) => RunNonCombatEffects.NamedRelic(name);
+
+    private static RunEngine Bones(int first, int second)
+    {
+        var engine = new RunEngine();
+        engine.Reset("NXV45HW43K");
+        engine.State.Phase = RunPhase.Ancient;
+        engine.State.NeowOptions[0] = RunConstants.RelicNeowsBones;
+        Step(engine, 0);
+        engine.State.RelicReward = first;
+        engine.State.PendingBonusRelicRewards[0] = second;
+        return engine;
+    }
+
+    private static void FinishSelection(RunEngine engine)
+    {
+        while (engine.State.Phase == RunPhase.TransformSelect)
+        {
+            Step(
+                engine,
+                Enumerable
+                    .Range(0, engine.State.Deck.Count)
+                    .First(i => RunNonCombatEffects.CanSelectCard(engine.State, i))
+            );
+        }
+    }
+
+    /// <summary>
+    /// Lost Coffer then Precise Scissors: the removal comes back to a screen still holding
+    /// the Coffer's potion and card reward, and the curse lands once those are answered
+    /// too. It used to stay pending until some later relic claim.
+    /// </summary>
+    [Fact]
+    public void TheCurseLandsWhenTheScreenEmptiesThroughACardReward()
+    {
+        var engine = Bones(Relic("LostCoffer"), Relic("PreciseScissors"));
+        Step(engine, 0); // Lost Coffer: potion, Scissors, card reward on the screen
+        Step(engine, 1); // Precise Scissors
+        FinishSelection(engine);
+        Assert.Equal(RunPhase.RelicReward, engine.State.Phase);
+
+        Step(engine, 0); // the potion
+        Step(engine, 0); // the card reward
+        Assert.Equal(RunPhase.CardReward, engine.State.Phase);
+        Step(engine, 0);
+
+        Assert.Equal(RunPhase.Ancient, engine.State.Phase);
+        Assert.False(engine.State.PendingNeowsBonesCurse);
+    }
+
+    /// <summary>
+    /// Lost Coffer then Kaleidoscope, a Kaleidoscope reward answered first: the Coffer's
+    /// cards are still the Coffer's when its reward is claimed (they were wiped to 0, 0, 0).
+    /// </summary>
+    [Fact]
+    public void AnOtherCharacterRewardDoesNotWipeTheScreensCardReward()
+    {
+        var engine = Bones(Relic("LostCoffer"), Relic("Kaleidoscope"));
+        Step(engine, 0); // Lost Coffer
+        int[] coffer = [.. engine.State.RewardCards];
+        Step(engine, 1); // Kaleidoscope: potion, card reward, two other-character rewards
+
+        Step(engine, 2); // an other-character reward first
+        Assert.Equal(RunPhase.CardReward, engine.State.Phase);
+        Step(engine, RunConstants.RewardSkipAction);
+        Step(engine, 1); // the Coffer's card reward
+
+        Assert.Equal(RunPhase.CardReward, engine.State.Phase);
+        Assert.Equal(coffer, engine.State.RewardCards);
+    }
+
+    /// <summary>
+    /// Kaleidoscope rolls both of its rewards as it is obtained, so a relic claimed in
+    /// between (Arcane Scroll's card) cannot change them.
+    /// </summary>
+    [Fact]
+    public void KaleidoscopesCardsDoNotDependOnClaimOrder()
+    {
+        var first = Bones(Relic("Kaleidoscope"), Relic("ArcaneScroll"));
+        Step(first, 0);
+        Step(first, 1); // an other-character reward straight away
+        int[] straight = [.. first.State.RewardCards];
+
+        var later = Bones(Relic("Kaleidoscope"), Relic("ArcaneScroll"));
+        Step(later, 0);
+        Step(later, 0); // Arcane Scroll first
+        Step(later, 0); // then the other-character reward
+
+        Assert.Equal(straight, later.State.RewardCards);
+    }
+}
