+using Sts2Emulator.Core;
+using Sts2Emulator.Core.Effects;
+using Sts2Emulator.Core.Run;
+using Xunit;
+
+namespace Sts2Emulator.Tests;
+
+/// <summary>
+/// A rest site's Proceed is disabled until an option has been taken: in every recorded
+/// rest site the button was off while an option was on, and on once it was taken. The
+/// emulator offered it from the start, a way out of a rest site with nothing done.
+/// </summary>
+public class RestSiteProceedTests
+{
+    private static RunEngine AtRest(params int[] relics)
+    {
+        var engine = new RunEngine();
+        engine.Reset("NXV45HW43K");
+        foreach (int relic in relics)
+        {
+            RunNonCombatEffects.ApplyRelicPickup(engine.State, relic);
+        }
+
+        engine.State.Phase = RunPhase.Rest;
+        engine.State.RestOptionsTaken = 0;
+        return engine;
+    }
+
+    private static int[] Mask(RunEngine engine)
+    {
+        var mask = new int[RunConstants.MaxActions];
+        engine.WriteActionMask(mask);
+        return mask;
+    }
+
+    private static void Step(RunEngine engine, int action) =>
+        Assert.Equal(0, engine.Step(action, -1, out _, out _, out _));
+
+    [Fact]
+    public void ProceedIsOffWhileNoOptionHasBeenTaken()
+    {
+        var mask = Mask(AtRest());
+
+        Assert.Equal(1, mask[RunConstants.RestHealAction]);
+        Assert.Equal(0, mask[RunConstants.RewardSkipAction]);
+    }
+
+    [Fact]
+    public void ProceedComesOnOnceAnOptionIsTaken()
+    {
+        var engine = AtRest();
+        Step(engine, RunConstants.RestHealAction);
+
+        Assert.Equal(RunPhase.Rest, engine.State.Phase);
+        Assert.Equal(1, Mask(engine)[RunConstants.RewardSkipAction]);
+    }
+
+    /// <summary>Miniature Tent keeps the others up after the first, and Proceed with them.</summary>
+    [Fact]
+    public void WithMiniatureTentTheSecondOptionCanBeDeclined()
+    {
+        var engine = AtRest(RelicEffects.MiniatureTent);
+        Step(engine, RunConstants.RestHealAction);
+
+        var mask = Mask(engine);
+        Assert.Equal(1, mask[RunConstants.RestUpgradeAction]);
+        Assert.Equal(1, mask[RunConstants.RewardSkipAction]);
+    }
+
+    /// <summary>
+    /// Dream Catcher's card reward leaves a rest from its result page for the map; the
+    /// result page used to stay pending, and the next rest site's first move did nothing
+    /// but leave.
+    /// </summary>
+    [Fact]
+    public void ARestSiteAfterDreamCatchersRewardStartsFresh()
+    {
+        var engine = AtRest(RunNonCombatEffects.NamedRelic("DreamCatcher"));
+        Step(engine, RunConstants.RestHealAction);
+        Assert.Equal(RunPhase.CardReward, engine.State.Phase);
+        Step(engine, RunConstants.RewardSkipAction);
+        Assert.Equal(RunPhase.Map, engine.State.Phase);
+
+        engine.State.MapNodeTypes[0] = RunConstants.NodeRest;
+        engine.State.MapOptionCoords[0] = engine.State.CurrentMapCoord with { Row = engine.State.CurrentMapCoord.Row + 1 };
+        Step(engine, 0);
+        Assert.Equal(RunPhase.Rest, engine.State.Phase);
+        int hp = engine.State.PlayerHp = 1;
+        Step(engine, RunConstants.RestHealAction);
+
+        Assert.True(engine.State.PlayerHp > hp);
+    }
+}
