+using System.Linq;
+using Sts2Emulator.Core;
+using Sts2Emulator.Core.Run;
+using Xunit;
+
+namespace Sts2Emulator.Tests;
+
+/// <summary>
+/// Events that open their card rewards directly -- the Trial's Guilty verdict on a
+/// Nondescript defendant (two), Colorful Philosophers (three) -- offer every one of them,
+/// one screen after another. Answering the first used to go straight on to the map, and
+/// the rest stayed queued, flagged as pending, for whatever rewards screen came next.
+/// </summary>
+public class DirectCardRewardTests
+{
+    private static RunEngine AtEvent(int eventId, int page = 0)
+    {
+        var engine = new RunEngine();
+        engine.Reset("NXV45HW43K");
+        engine.State.Phase = RunPhase.Event;
+        engine.State.EventId = eventId;
+        engine.State.EventPage = page;
+        return engine;
+    }
+
+    private static void Step(RunEngine engine, int action) =>
+        Assert.Equal(0, engine.Step(action, -1, out _, out _, out _));
+
+    /// <summary>Answers every screen in turn (taking a card or skipping) and lists them.</summary>
+    private static System.Collections.Generic.List<int[]> AnswerAll(RunEngine engine, int action)
+    {
+        var screens = new System.Collections.Generic.List<int[]>();
+        while (engine.State.Phase == RunPhase.CardReward)
+        {
+            screens.Add([.. engine.State.RewardCards.Where(id => id != 0)]);
+            Step(engine, action);
+        }
+
+        return screens;
+    }
+
+    [Theory]
+    [InlineData(0)] // take the first card each time
+    [InlineData(RunConstants.RewardSkipAction)]
+    public void TheTrialsGuiltyVerdictOffersBothCardRewards(int answer)
+    {
+        var engine = AtEvent(RunConstants.EventTrial, page: 3);
+        Step(engine, 0);
+        int[] first = [.. engine.State.RewardCards];
+        int[] second = engine.State.PendingCardOffers.Single();
+        int deck = engine.State.Deck.Count;
+
+        var screens = AnswerAll(engine, answer);
+
+        Assert.Equal(new[] { first.Where(id => id != 0).ToArray(), second }, screens);
+        Assert.Equal(deck + (answer == 0 ? 2 : 0), engine.State.Deck.Count);
+        Assert.Equal(RunPhase.Map, engine.State.Phase);
+        Assert.False(RunRewardGenerator.HasPendingRewards(engine.State));
+    }
+
+    [Fact]
+    public void ColorfulPhilosophersOfferAllThreeCardRewards()
+    {
+        var engine = AtEvent(RunConstants.EventColorfulPhilosophers);
+        Step(engine, 0);
+
+        var screens = AnswerAll(engine, 0);
+
+        Assert.Equal(3, screens.Count);
+        Assert.All(screens, screen => Assert.Equal(3, screen.Length));
+        Assert.False(RunRewardGenerator.HasPendingRewards(engine.State));
+    }
+}
