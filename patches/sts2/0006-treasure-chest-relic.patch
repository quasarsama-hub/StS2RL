diff --git a/src/Sts2Emulator.Tests/TreasureChestRelicTests.cs b/src/Sts2Emulator.Tests/TreasureChestRelicTests.cs
new file mode 100644
index 0000000..6384936
--- /dev/null
+++ b/src/Sts2Emulator.Tests/TreasureChestRelicTests.cs
@@ -0,0 +1,79 @@
+using Sts2Emulator.Core;
+using Sts2Emulator.Core.Run;
+using Xunit;
+
+namespace Sts2Emulator.Tests;
+
+/// <summary>
+/// A treasure chest pays a relic as well as its gold. The emulator used to pay only the
+/// gold: the `treasure_room_relics` stream and the shared grab bag were built and cloned
+/// but never drawn from.
+/// </summary>
+public class TreasureChestRelicTests
+{
+    private static RunEngine Run(string seed = "ABCDEF")
+    {
+        var engine = new RunEngine();
+        engine.Reset(seed);
+        return engine;
+    }
+
+    [Fact]
+    public void AChestOffersOneSharedPoolRelicOnTheRewardScreen()
+    {
+        var engine = Run();
+        var state = engine.State;
+
+        RunRewardGenerator.EnterTreasureRoom(state);
+
+        Assert.Equal(RunPhase.RelicReward, state.Phase);
+        Assert.NotEqual(0, state.RelicReward);
+        Assert.Contains(state.RelicReward, GeneratedData.RelicPools.Shared.ToArray());
+        Assert.Contains(
+            GeneratedData.Relics.Get(state.RelicReward).Rarity,
+            new[] { RelicRarity.Common, RelicRarity.Uncommon, RelicRarity.Rare }
+        );
+        Assert.Equal(1, state.Rng.TreasureRoomRelics.CallCount);
+    }
+
+    [Fact]
+    public void ClaimingTheChestRelicObtainsItAndStrikesItFromBothBags()
+    {
+        var engine = Run();
+        var state = engine.State;
+        RunRewardGenerator.EnterTreasureRoom(state);
+        int offered = state.RelicReward;
+
+        Assert.Equal(0, engine.Step(0, -1, out _, out _, out _));
+
+        Assert.Contains(state.Relics, relic => relic.DefId == offered);
+        Assert.DoesNotContain(offered, state.RelicBag.Remaining);
+        Assert.DoesNotContain(offered, state.SharedRelicBag.Remaining);
+    }
+
+    [Fact]
+    public void SilverCrucibleEmptiesOnlyTheFirstChest()
+    {
+        // "The first Treasure Chest you open is empty."
+        var engine = Run();
+        var state = engine.State;
+        state.Relics.Add(new RelicInstance(RunConstants.RelicSilverCrucible, 0));
+        int gold = state.Gold;
+
+        RunRewardGenerator.EnterTreasureRoom(state);
+
+        Assert.Equal(RunPhase.Treasure, state.Phase);
+        Assert.Equal(0, state.RelicReward);
+        Assert.Equal(gold, state.Gold);
+        Assert.Equal(0, state.Rng.TreasureRoomRelics.CallCount);
+
+        var copy = engine.Clone();
+        foreach (var run in new[] { engine, copy })
+        {
+            RunRewardGenerator.EnterTreasureRoom(run.State);
+            Assert.Equal(RunPhase.RelicReward, run.State.Phase);
+            Assert.NotEqual(0, run.State.RelicReward);
+            Assert.True(run.State.Gold > gold);
+        }
+    }
+}
diff --git a/src/Sts2Emulator/Core/Run/RunRewardGenerator.cs b/src/Sts2Emulator/Core/Run/RunRewardGenerator.cs
index 34db889..b539376 100644
--- a/src/Sts2Emulator/Core/Run/RunRewardGenerator.cs
+++ b/src/Sts2Emulator/Core/Run/RunRewardGenerator.cs
@@ -997,15 +997,42 @@ public static class RunRewardGenerator
     public static void EnterTreasureRoom(RunState state)
     {
         ClearRewardScreen(state);
-        if (state.Relics.Any(relic => relic.DefId == RunConstants.RelicSilverCrucible))
+        // Silver Crucible: "The first Treasure Chest you open is empty." The FIRST -- this
+        // used to empty every chest for the rest of the run.
+        if (
+            !state.SilverCrucibleChestEmptied
+            && state.Relics.Any(relic => relic.DefId == RunConstants.RelicSilverCrucible)
+        )
         {
+            state.SilverCrucibleChestEmptied = true;
             state.Phase = RunPhase.Treasure;
             return;
         }
 
         int gold = state.PlayerRng.Rewards.NextInt(42, 53);
         RunNonCombatEffects.GainGold(state, (int)(gold * 0.75));
-        state.Phase = RunPhase.Treasure;
+
+        // The chest's relic. `TreasureRoom` opens a relic-picking session
+        // (`TreasureRoomRelicSynchronizer.BeginRelicPicking`) that offers one relic per
+        // player, drawn from the SHARED grab bag at a rarity rolled on the run's own
+        // `treasure_room_relics` stream -- the stream and the bag this emulator already
+        // builds and clones but, until now, never drew from, so every chest paid its gold
+        // and no relic. It goes on the ordinary reward screen so the claim runs the
+        // relic's AfterObtained (and any screen that opens) exactly as an elite's does.
+        state.RelicReward = NextTreasureRelic(state);
+        state.Phase = RunPhase.RelicReward;
+    }
+
+    /// <summary>One chest relic: rarity off the treasure stream, front of the shared bag.</summary>
+    public static int NextTreasureRelic(RunState state)
+    {
+        var rarity = RelicGrabBag.RollRarity(state.Rng.TreasureRoomRelics);
+        int? relicId = state.SharedRelicBag.Pull(
+            rarity,
+            fromFront: true,
+            RelicGrabBag.AllowedInSoloRun(state.Floor)
+        );
+        return relicId ?? FallbackRelic;
     }
 
     public static void EnterShop(RunState state)
